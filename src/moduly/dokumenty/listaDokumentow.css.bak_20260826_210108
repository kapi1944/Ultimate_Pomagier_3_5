.lista-dokumentow {
  display: grid;
  gap: 18px;
}

.lista-dokumentow__naglowek,
.lista-dokumentow__filtry,
.lista-dokumentow__karta,
.lista-dokumentow__akcje {
  display: flex;
  gap: 12px;
}

.lista-dokumentow__naglowek {
  align-items: start;
  justify-content: space-between;
}

.lista-dokumentow__naglowek h1,
.lista-dokumentow__karta h2 {
  margin: 0;
}

.lista-dokumentow button,
.lista-dokumentow input,
.lista-dokumentow select {
  border: 1px solid color-mix(in srgb, var(--ui-akcent) 35%, transparent);
  border-radius: 6px;
  background: var(--ui-powierzchnia);
  color: var(--ui-tekst);
  font: inherit;
}

.lista-dokumentow button {
  min-height: 36px;
  cursor: pointer;
  padding: 7px 10px;
}

.lista-dokumentow button:hover:not(:disabled) {
  border-color: var(--ui-akcent);
  background: var(--ui-akcent-mocny);
}

.lista-dokumentow button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
}

.lista-dokumentow__filtry {
  flex-wrap: wrap;
  align-items: end;
  border: 1px solid color-mix(in srgb, var(--ui-akcent) 24%, transparent);
  border-radius: 8px;
  background: var(--ui-panel);
  padding: 14px;
}

.lista-dokumentow__filtry label {
  display: grid;
  gap: 5px;
  color: var(--ui-tekst-drugi);
  font-size: 0.82rem;
}

.lista-dokumentow__filtry input,
.lista-dokumentow__filtry select {
  min-height: 36px;
  padding: 6px 8px;
}

.lista-dokumentow__przelacznik {
  display: flex !important;
  align-items: center;
  min-height: 36px;
}

.lista-dokumentow__przelacznik input {
  min-height: 0;
}

.lista-dokumentow__licznik,
.lista-dokumentow__stan,
.lista-dokumentow__typ {
  margin: 0;
}

.lista-dokumentow__licznik {
  color: var(--ui-tekst-drugi);
}

.lista-dokumentow__stan {
  border: 1px dashed color-mix(in srgb, var(--ui-tekst-drugi) 40%, transparent);
  border-radius: 8px;
  padding: 18px;
}

.lista-dokumentow__stan--blad {
  border-color: rgba(248, 113, 113, 0.7);
  color: #fecaca;
}

.lista-dokumentow__wyniki {
  display: grid;
  gap: 12px;
}

.lista-dokumentow__pozycja {
  position: relative;
}

.lista-dokumentow__pozycja--spalana {
  animation: lista-dokumentow-spalanie 0.9s ease-in forwards;
  overflow: hidden;
  pointer-events: none;
}

.lista-dokumentow__pozycja--spalana::after {
  position: absolute;
  right: -8%;
  bottom: -18%;
  left: -8%;
  height: 45%;
  background:
    radial-gradient(ellipse at 10% 100%, #fff7a8 0 7%, #ffb000 8% 18%, transparent 19%),
    radial-gradient(ellipse at 34% 100%, #fff 0 5%, #ff6a00 6% 22%, transparent 23%),
    radial-gradient(ellipse at 62% 100%, #ffd54a 0 8%, #ef2b0c 9% 24%, transparent 25%),
    radial-gradient(ellipse at 88% 100%, #fff3a0 0 6%, #ff7800 7% 20%, transparent 21%);
  content: '';
  filter: blur(1px);
  mix-blend-mode: screen;
  animation: lista-dokumentow-plomienie 0.9s ease-in forwards;
}

.lista-dokumentow__spal {
  border-color: rgba(251, 146, 60, 0.75) !important;
  background: #4a1707 !important;
  color: #fff1de !important;
}

.lista-dokumentow__spal:hover:not(:disabled) {
  border-color: #fdba74 !important;
  background: #6b2108 !important;
}

.lista-dokumentow__karta {
  flex-direction: column;
  border: 1px solid color-mix(in srgb, var(--ui-akcent) 28%, transparent);
  border-radius: 8px;
  background: var(--ui-panel);
  padding: 16px;
}

.lista-dokumentow__karta--dyplom {
  display: grid;
  grid-template-columns: 172px minmax(0, 1fr);
  align-items: stretch;
}

.lista-dokumentow__miniatura-dyplomu {
  display: grid;
  min-width: 0;
  position: relative;
  align-self: start;
  aspect-ratio: 210 / 297;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--ui-akcent) 20%, transparent);
  border-radius: 6px;
  background: #ffffff;
}

.lista-dokumentow__miniatura-dyplomu img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lista-dokumentow__podglad-pierwszej-strony-dyplomu {
  position: relative;
  z-index: 1;
  display: grid;
  width: 100%;
  height: 100%;
  grid-template-rows: auto auto 1fr auto;
  gap: 7px;
  padding: 10px 8px 8px;
  box-sizing: border-box;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(219, 234, 254, 0.88));
  color: #1e3a5f;
  text-align: center;
}

.lista-dokumentow__podglad-rejestr {
  font-size: 0.42rem;
  text-align: left;
}

.lista-dokumentow__podglad-naglowek-dyplomu,
.lista-dokumentow__podglad-tresc-dyplomu {
  display: grid;
  gap: 4px;
}

.lista-dokumentow__podglad-naglowek-dyplomu strong {
  font-size: 0.77rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.lista-dokumentow__podglad-naglowek-dyplomu span,
.lista-dokumentow__podglad-tresc-dyplomu span {
  font-size: 0.42rem;
  letter-spacing: 0.05em;
}

.lista-dokumentow__podglad-tresc-dyplomu {
  align-content: center;
}

.lista-dokumentow__podglad-tresc-dyplomu strong {
  font-size: 0.64rem;
}

.lista-dokumentow__podglad-tresc-dyplomu em {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  color: #31527c;
  font-size: 0.48rem;
  font-style: normal;
  line-height: 1.25;
}

.lista-dokumentow__podglad-stopka-dyplomu {
  font-size: 0.54rem;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.lista-dokumentow__tresc-dyplomu {
  display: grid;
  min-width: 0;
  gap: 12px;
}

.lista-dokumentow__metadane--dyplom {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.lista-dokumentow__karta-naglowek {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.lista-dokumentow__karta-naglowek strong {
  align-self: start;
  border-radius: 999px;
  background: var(--ui-akcent-mocny);
  color: #bbf7d0;
  font-size: 0.78rem;
  padding: 4px 8px;
}

.lista-dokumentow__typ {
  color: var(--ui-tekst-drugi);
  font-size: 0.8rem;
}

.lista-dokumentow__metadane {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin: 0;
}

.lista-dokumentow__metadane div {
  min-width: 0;
}

.lista-dokumentow__metadane dt {
  color: var(--ui-tekst-drugi);
  font-size: 0.76rem;
}

.lista-dokumentow__metadane dd {
  overflow-wrap: anywhere;
  margin: 2px 0 0;
}

.lista-dokumentow__akcje {
  flex-wrap: wrap;
}

@keyframes lista-dokumentow-spalanie {
  0%, 35% {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }

  100% {
    clip-path: inset(0 0 100% 0);
    opacity: 0;
  }
}

@keyframes lista-dokumentow-plomienie {
  0% {
    transform: translateY(0) scaleY(0.25);
    opacity: 0.25;
  }

  100% {
    transform: translateY(-170%) scaleY(2.2);
    opacity: 1;
  }
}

@media (max-width: 760px) {
  .lista-dokumentow__naglowek {
    flex-direction: column;
  }

  .lista-dokumentow__metadane {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .lista-dokumentow__karta--dyplom {
    grid-template-columns: 124px minmax(0, 1fr);
  }
}

@media (max-width: 440px) {
  .lista-dokumentow__metadane {
    grid-template-columns: 1fr;
  }

  .lista-dokumentow__karta-naglowek {
    flex-direction: column;
  }

  .lista-dokumentow__karta--dyplom {
    grid-template-columns: 1fr;
  }

  .lista-dokumentow__miniatura-dyplomu {
    max-width: 180px;
  }
}


/* Szybkie tworzenie dokumentów na ekranie „Wszystkie dokumenty”. */
.dokumenty-szybkie-akcje {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
  margin: 12px 0 16px;
}

.dokumenty-szybka-akcja {
  min-width: 0;
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border: 1px solid currentColor;
  border-radius: 8px;
  background: transparent;
  color: inherit;
  font: inherit;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
  transition:
    transform 120ms ease,
    background-color 120ms ease;
}

.dokumenty-szybka-akcja:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.04);
}

.dokumenty-szybka-akcja:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.dokumenty-szybka-akcja-plus {
  flex: 0 0 auto;
  font-size: 2.15rem;
  line-height: 1;
  font-weight: 500;
}

.dokumenty-szybka-akcja-etykieta {
  min-width: 0;
}

@media (max-width: 1400px) {
  .dokumenty-szybkie-akcje {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .dokumenty-szybkie-akcje {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 480px) {
  .dokumenty-szybkie-akcje {
    grid-template-columns: 1fr;
  }
}
